FROM python:3.12-slim

WORKDIR /backend

# Copy requirements (create a requirements.txt for main backend if not already)
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy all main backend code
COPY . .

# Expose port
EXPOSE 8001

# Default command
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
